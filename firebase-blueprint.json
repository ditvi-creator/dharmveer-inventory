{
  "entities": {
    "StockItem": {
      "title": "StockItem",
      "description": "An inventory item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "unit": { "type": "string" },
        "openingStockMP": { "type": "number" },
        "openingStockKL": { "type": "number" },
        "stockIn": { "type": "number" },
        "stockOut": { "type": "number" },
        "balance": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "booked": { "type": "number" },
        "partyName": { "type": "string" },
        "updatedAt": { "type": "number" },
        "ownerId": { "type": "string" },
        "bookings": { "type": "array" }
      },
      "required": ["name", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "companyName": { "type": "string" },
        "businessAddress": { "type": "string" },
        "isSubscribed": { "type": "boolean" },
        "trialStartedAt": { "type": "any" },
        "updatedAt": { "type": "number" }
      },
      "required": ["fullName", "updatedAt"]
    }
  },
  "firestore": {
    "/stockItems/{itemId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Shared inventory items"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile details"
    }
  }
}
